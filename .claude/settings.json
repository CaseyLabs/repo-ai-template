{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/project-context.py *)",
      "Bash(python3 tools/ai-check.py *)",
      "Bash(python3 tools/check-doc-links.py *)",
      "Bash(python3 tools/project-run.py --list *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)"
    ]
  }
}
